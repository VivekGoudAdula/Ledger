# Ledger Environment Configuration Template

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Database Configuration (SQLite WAL Mode)
DATABASE_URL=sqlite+aiosqlite:///./ledger.db
SQLITE_WAL_MODE=True

# Optional External API Keys (Public endpoints work without keys)
GITHUB_TOKEN=

# System Limits & Tenant Quotas
DEFAULT_TENANT_ID=default
MAX_QUEUE_CAPACITY=1000
